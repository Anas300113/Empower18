# =============================================================================
# Empower18 — Environment variable template
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
# Runtime connection: Supabase session pooler (persistent Express server)
DATABASE_URL="postgresql://postgres:PASSWORD@db.nasefnbffsdxzjplzfmh.supabase.co:6543/postgres"
# Migrations: direct connection (port 5432), separate from runtime pool
MIGRATION_DATABASE_URL="postgresql://postgres:PASSWORD@db.nasefnbffsdxzjplzfmh.supabase.co:5432/postgres"

# --- Supabase ---
SUPABASE_URL="https://nasefnbffsdxzjplzfmh.supabase.co"
# Publishable (anon) key — safe to expose to the browser
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"
# Secret key — server-side ONLY, bypasses RLS. Never expose to browser.
SUPABASE_SECRET_KEY="sb_secret_your_secret_key_here"

# --- Public variables exposed to the Vite browser app ---
# Only these are prefixed with VITE_ and bundled into the client
VITE_SUPABASE_URL="https://nasefnbffsdxzjplzfmh.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"

# --- AI provider ---
# Choose one: openai, anthropic, google, openrouter
AI_PROVIDER="openai"
AI_API_KEY="your_ai_api_key_here"
AI_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Email (Resend) ---
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Empower18 <noreply@yourdomain.example>"

# --- Application ---
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# --- Opportunity expiry maintenance (server-only; never prefix with VITE_) ---
# Use a random secret of at least 32 characters and store the same value as the
# GitHub Actions secret OPPORTUNITY_EXPIRY_SECRET. Configure an existing admin
# Supabase Auth UUID as the audit actor; the server verifies its admin role.
OPPORTUNITY_EXPIRY_SECRET=""
OPPORTUNITY_EXPIRY_ACTOR_USER_ID=""

# --- Opportunity connectors (server-only; never prefix with VITE_) ---
# Public board/company identifiers are configuration, not credentials.
GREENHOUSE_BOARD_TOKEN=""
ASHBY_BOARD_NAME=""
LEVER_COMPANY=""
# GOV.UK Display Advert API v2 subscription key.
GOVUK_API_KEY=""
# Optional scheduler settings for the ingestion worker.
OPPORTUNITY_SYNC_CRON="0 * * * *"
OPPORTUNITY_SYNC_MAX_PAGES="100"

# --- Optional Manus platform API integration (not used for authentication) ---
MANUS_PROJECT_ID=""
MANUS_API_URL=""
MANUS_API_KEY=""
